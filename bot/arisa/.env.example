# arisa 바이너리가 떠 있는 주소. 패드가 다른 기기면 그 기기의 IP 를 적는다.
# 패드에서 ARISA_BIND=0.0.0.0:3000 으로 띄워야 밖에서 붙을 수 있다.
ARISA_TARGET=192.168.0.10:3000

# 카페 새글 알림용 깃헙 토큰
#   - limbj1218-cyber/cafe-watch : Contents 읽기
#   - limbj1218-cyber/chatlog    : Actions 쓰기 (워크플로우 깨우기)
# ★ 이 파일은 절대 깃헙에 올리지 않는다 (.gitignore 에 있음)
GITHUB_TOKEN=

# 캐시·대화기록·상태 파일 위치 (비워두면 사용자 홈의 .autoworker-bot)
AUTOWORKER_DATA_DIR=

LOG_LEVEL=INFO
