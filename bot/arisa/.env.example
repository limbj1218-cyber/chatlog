# arisa 가 떠 있는 주소.
#   · 같은 PC 에서 arisa 를 돌리는 경우 (보통 이 경우) → 아래 그대로 두면 된다
#   · 다른 기기(패드 등)에서 돌리는 경우 → 그 기기의 IP. 예) 192.168.0.23:3000
#     이때는 arisa 를 ARISA_BIND=0.0.0.0:3000 으로 띄워야 밖에서 붙을 수 있다
ARISA_TARGET=127.0.0.1:3000

# 카페 새글 알림용 깃헙 토큰
#   - limbj1218-cyber/cafe-watch : Contents 읽기
#   - limbj1218-cyber/chatlog    : Actions 쓰기 (워크플로우 깨우기)
# 비워두면 카페 알림만 동작하지 않고 나머지(자동응답·기록)는 그대로 된다.
# ★ 이 파일은 절대 깃헙에 올리지 않는다 (.gitignore 에 있음)
GITHUB_TOKEN=

# 캐시·대화기록·상태 파일 위치 (비워두면 사용자 홈의 .autoworker-bot)
AUTOWORKER_DATA_DIR=

# 들어오는 메시지를 전부 보고 싶으면 DEBUG
LOG_LEVEL=INFO
